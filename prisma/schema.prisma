generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}

model Client {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  phone     String?
  createdAt DateTime   @default(now())
  bookings  Booking[]
  tokens    MagicToken[]
}

model MagicToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [email], references: [email])
}

model Booking {
  id           String    @id @default(cuid())
  name         String
  phone        String
  carBrand     String?
  carModel     String?
  carCategory  String?   // "car" | "truck" | "trailer"
  service      String?
  date         DateTime?
  scheduledAt  DateTime? // точна дата+час запису
  scheduledEnd DateTime? // кінець слоту
  workerId     Int?      // 1-5 вантажні, 6-7 легкові
  message      String?
  status       String    @default("new")
  progress     String    @default("received")
  price        Float?
  clientEmail  String?
  client       Client?   @relation(fields: [clientEmail], references: [email])
  createdAt    DateTime  @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model Service {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  short        String
  description  String
  price        String
  priceMin     Int
  priceMax     Int
  priceCar     Int?
  priceTruck   Int?
  priceTrailer Int?
  hours        String
  image        String
  category     String
  details      String[]
  order        Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
