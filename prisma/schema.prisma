generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}

model Booking {
  id        String    @id @default(cuid())
  name      String
  phone     String
  carBrand  String?
  carModel  String?
  service   String?
  date      DateTime?
  message   String?
  status    String    @default("new")
  createdAt DateTime  @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
}
